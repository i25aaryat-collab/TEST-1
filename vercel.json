{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "regions": [
        "hnd1"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(self), camera=(), microphone=()"
      },
      "continue": true
    },
    {
      "src": "^/(config|includes|database|data)/(.*)$",
      "status": 404
    },
    {
      "src": "^/$",
      "dest": "/api/index.php?__path=index.php"
    },
    {
      "src": "^/(.+\\.php)$",
      "dest": "/api/index.php?__path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php?__path=$1"
    }
  ]
}
